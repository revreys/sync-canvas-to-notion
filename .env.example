# Canvas
CANVAS_BASE_URL="https://your-school.instructure.com"
CANVAS_TOKEN="paste_canvas_token_here"

# Notion
NOTION_TOKEN="paste_notion_integration_token_here"
NOTION_DATA_SOURCE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"   # data source id (not page id)
NOTION_VERSION="2025-09-03"

# Optional
TIMEZONE="America/Chicago"

# Optional course mapping (JSON)
# COURSE_NAME_MAP_JSON='{"Canvas Course Name Here":"Notion Select Name"}'
COURSE_NAME_MAP_JSON='{}'

# Optional if your Notion column names differ
# NOTION_PROP_NAME="Name"
# NOTION_PROP_COURSE="Course"
# NOTION_PROP_DUE_DATE="Due Date"
# NOTION_PROP_CANVAS_ID="Canvas ID"
# NOTION_PROP_COURSE_ID="Course ID"
# NOTION_PROP_URL="URL"

# Optional knobs
MATCH_MINUTES_WINDOW="2"
PER_PAGE="100"
HTTP_TIMEOUT="30"
LOG_LEVEL="INFO"
